{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/gumi-one-room",
      "destination": "/api/seo-landing?slug=gumi-one-room"
    },
    {
      "source": "/jinpyeong-mini-two-room",
      "destination": "/api/seo-landing?slug=jinpyeong-mini-two-room"
    },
    {
      "source": "/gumi-two-room",
      "destination": "/api/seo-landing?slug=gumi-two-room"
    },
    {
      "source": "/gumi-rental-building-sale",
      "destination": "/api/seo-landing?slug=gumi-rental-building-sale"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/listing-seo?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/signup",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legal/terms",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legal/privacy",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/sso-api",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
